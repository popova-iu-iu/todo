{
  "name": "elektronnaya-muzyka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Электронная музыка с нуля — интерактивный курс (Ableton Live, MiniLab 3, Zoom H1essential) как приложение для iPhone, работает без интернета",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run build && playwright test --trace off",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "tone": "14.8.49"
  }
}
